<section class="bg-cream" id="oferta">
  <div class="wrap-wide reveal">
    <div style="max-width:44rem;margin-inline:auto">
      <p class="eyebrow">Escolha a opção que faz sentido para si</p>
      <h2>Duas formas de <span class="hl">começar hoje</span></h2>
    </div>

    <div class="plans">
      <article class="card plan">
        <p class="plan__name">Essencial</p>
        <p class="plan__price">7,90<span>€</span></p>
        <p class="plan__once">Pagamento único</p>
        <ul>
          <li>Método completo em 3 pilares</li>
          <li>Lista de Compras Inteligente</li>
